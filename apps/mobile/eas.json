{
  "cli": {
    "version": ">= 16.17.0",
    "appVersionSource": "remote"
  },
  "build": {
    "workflowD": {
      "distribution": "internal",
      "environment": "preview",
      "env": {
        "APP_VARIANT": "workflowD"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "workflowD-testflight": {
      "extends": "workflowD",
      "distribution": "store",
      "autoIncrement": true
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://tamir-bakim-api.onrender.com"
      }
    },
    "production": {
      "distribution": "store",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://tamir-bakim-api.onrender.com"
      }
    }
  },
  "submit": {
    "workflowD-testflight": {},
    "production": {}
  }
}
