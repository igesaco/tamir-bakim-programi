{
  "expo": {
    "name": "Tamir Bakım",
    "slug": "tamir-bakim-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "android": {
      "package": "com.igesa.tamirbakim",
      "versionCode": 1,
      "icon": "./assets/icon.png"
    },
    "ios": {
      "bundleIdentifier": "com.igesa.tamirbakim",
      "supportsTablet": true,
      "buildNumber": "1",
      "icon": "./assets/icon.png",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Araç ve servis fotoğraflarını iş emrine eklemek için fotoğraflarınıza erişim gerekir.",
          "cameraPermission": "Ruhsat, kimlik, araç ve servis fotoğraflarını çekmek için kameraya erişim gerekir.",
          "microphonePermission": false
        }
      ],
      [
        "expo-mlkit-ocr",
        {
          "iosEngine": "auto"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4",
            "useFrameworks": "static"
          }
        }
      ]
    ],
    "scheme": "tamirbakim",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#080d11"
    },
    "owner": "igesacos-team",
    "extra": {
      "eas": {
        "projectId": "ef121369-1d22-4c0a-853b-184297ceb2ff"
      }
    }
  }
}
