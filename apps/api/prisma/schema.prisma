generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/* =========================================================
   ENUMS
   ========================================================= */

enum UserRole {
  OWNER
  MANAGER
  SERVICE_ADVISOR
  TECHNICIAN
  WAREHOUSE
  ACCOUNTING
}

enum AppointmentStatus {
  REQUESTED
  CONFIRMED
  RESCHEDULED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum InspectionStatus {
  DRAFT
  COMPLETED
}

enum ServiceOrderStatus {
  APPOINTMENT
  ARRIVED
  ACCEPTED
  INSPECTION
  QUOTE_WAITING
  APPROVED
  IN_PROGRESS
  PART_WAITING
  QUALITY_CONTROL
  READY
  PAYMENT_WAITING
  DELIVERED
  CANCELLED
}

enum ServiceItemType {
  LABOR
  PART
  OTHER
}

enum QuoteStatus {
  DRAFT
  SENT
  PARTIALLY_APPROVED
  APPROVED
  REJECTED
  EXPIRED
}

enum MaintenancePlanStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum InventoryMovementType {
  IN
  OUT
  ADJUSTMENT
  RETURN
}

enum MediaType {
  VEHICLE
  ACCEPTANCE
  DAMAGE
  ENGINE
  PART
  BEFORE
  AFTER
  ODOMETER
  DOCUMENT
  INVOICE
  OTHER
}

enum NotificationChannel {
  PUSH
  SMS
  WHATSAPP
  EMAIL
  IN_APP
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  READ
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  OTHER
}

enum PaymentStatus {
  PENDING
  PAID
  PARTIAL
  CANCELLED
  REFUNDED
}

/* =========================================================
   SERVİS / ŞUBE / PERSONEL
   ========================================================= */

model Organization {
  id        String   @id @default(cuid())
  name      String
  taxNumber String?
  phone     String?
  email     String?
  active    Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branches           Branch[]
  users              User[]
  customers          Customer[]
  vehicles           Vehicle[]
  appointments       Appointment[]
  inspections        Inspection[]
  serviceOrders      ServiceOrder[]
  quotes             Quote[]
  maintenanceRecords MaintenanceRecord[]
  maintenancePlans   MaintenancePlan[]
  maintenancePackages MaintenancePackage[]
  suppliers          Supplier[]
  parts              Part[]
  inventories        Inventory[]
  inventoryMovements InventoryMovement[]
  media              Media[]
  notifications      Notification[]
  payments           Payment[]
  auditLogs          AuditLog[]
}

model Branch {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  name    String
  phone   String?
  address String?
  city    String?
  active  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users              User[]
  customers          Customer[]
  vehicles           Vehicle[]
  appointments       Appointment[]
  inspections        Inspection[]
  serviceOrders      ServiceOrder[]
  quotes             Quote[]
  maintenanceRecords MaintenanceRecord[]
  maintenancePlans   MaintenancePlan[]
  inventories        Inventory[]
  inventoryMovements InventoryMovement[]
  media              Media[]
  notifications      Notification[]
  payments           Payment[]
  auditLogs          AuditLog[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model User {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id])

  firstName    String
  lastName     String
  email        String   @unique
  phone        String?
  passwordHash String
  role         UserRole
  active       Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdAppointments  Appointment[]
  inspections          Inspection[]
  assignedServiceOrders ServiceOrder[]
  inventoryMovements   InventoryMovement[]
  media                Media[]
  notifications        Notification[]
  auditLogs            AuditLog[]

  @@index([organizationId])
  @@index([branchId])
}

/* =========================================================
   MÜŞTERİ / ARAÇ
   ========================================================= */

model Customer {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id])

  firstName String
  lastName  String?
  phone     String?
  email     String?
  taxNumber String?
  address   String?
  notes     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vehicles      Vehicle[]
  appointments  Appointment[]
  serviceOrders ServiceOrder[]
  quotes        Quote[]
  notifications Notification[]
  payments      Payment[]

  @@index([organizationId])
  @@index([branchId])
  @@index([phone])
}

model Vehicle {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id])

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  plate        String
  vin          String?
  brand        String
  model        String
  packageName  String?
  modelYear    Int?
  engineType   String?
  engineCode   String?
  engineVolume String?
  fuelType     String?
  transmission String?
  color        String?
  mileage      Int @default(0)

  oilType       String?
  oilCapacity   String?
  tireSize      String?
  batteryInfo   String?
  notes         String?

  qrToken  String  @unique @default(cuid())
  qrActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appointments       Appointment[]
  inspections        Inspection[]
  serviceOrders      ServiceOrder[]
  quotes             Quote[]
  maintenanceRecords MaintenanceRecord[]
  maintenancePlans   MaintenancePlan[]
  media              Media[]

  @@unique([organizationId, plate])
  @@unique([organizationId, vin])
  @@index([customerId])
  @@index([branchId])
}

/* =========================================================
   RANDEVU
   ========================================================= */

model Appointment {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id])

  createdById String?
  createdBy   User? @relation(fields: [createdById], references: [id])

  startAt      DateTime
  endAt        DateTime?
  serviceType  String?
  customerNote String?
  internalNote String?

  status AppointmentStatus @default(REQUESTED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  notifications Notification[]

  @@index([organizationId])
  @@index([branchId])
  @@index([customerId])
  @@index([vehicleId])
  @@index([startAt])
}

/* =========================================================
   ARAÇ KABUL / KONTROL
   ========================================================= */

model Inspection {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id])

  serviceOrderId String?
  serviceOrder   ServiceOrder? @relation(fields: [serviceOrderId], references: [id])

  inspectorId String?
  inspector   User? @relation(fields: [inspectorId], references: [id])

  mileage        Int
  fuelLevel      String?
  customerComplaint String?
  existingDamage String?
  valuablesNote  String?

  status InspectionStatus @default(DRAFT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items InspectionItem[]
  media Media[]

  @@index([organizationId])
  @@index([vehicleId])
  @@index([serviceOrderId])
}

model InspectionItem {
  id           String     @id @default(cuid())
  inspectionId String
  inspection   Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  category          String
  name              String
  condition         String?
  note              String?
  recommendedAction String?
  estimatedPrice    Decimal? @db.Decimal(12, 2)

  createdAt DateTime @default(now())

  @@index([inspectionId])
}

/* =========================================================
   İŞ EMİRLERİ
   ========================================================= */

model ServiceOrder {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id])

  assignedTechnicianId String?
  assignedTechnician   User? @relation(fields: [assignedTechnicianId], references: [id])

  orderNumber String
  mileage     Int

  complaint    String?
  internalNote String?

  estimatedDeliveryAt DateTime?
  deliveredAt         DateTime?

  status ServiceOrderStatus @default(ACCEPTED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inspections        Inspection[]
  items              ServiceOrderItem[]
  quotes             Quote[]
  maintenanceRecord  MaintenanceRecord?
  inventoryMovements InventoryMovement[]
  media              Media[]
  notifications      Notification[]
  payments           Payment[]

  @@unique([organizationId, orderNumber])
  @@index([branchId])
  @@index([customerId])
  @@index([vehicleId])
  @@index([status])
}

model ServiceOrderItem {
  id             String       @id @default(cuid())
  serviceOrderId String
  serviceOrder   ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)

  partId String?
  part   Part? @relation(fields: [partId], references: [id])

  type        ServiceItemType
  name        String
  description String?

  quantity       Decimal @default(1) @db.Decimal(10, 2)
  unitPrice      Decimal @db.Decimal(12, 2)
  discountAmount Decimal @default(0) @db.Decimal(12, 2)
  totalPrice     Decimal @db.Decimal(12, 2)

  completed Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([serviceOrderId])
  @@index([partId])
}

/* =========================================================
   FİYAT TEKLİFLERİ
   ========================================================= */

model Quote {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id])

  serviceOrderId String?
  serviceOrder   ServiceOrder? @relation(fields: [serviceOrderId], references: [id])

  quoteNumber String
  status      QuoteStatus @default(DRAFT)

  subtotal      Decimal @default(0) @db.Decimal(12, 2)
  discountTotal Decimal @default(0) @db.Decimal(12, 2)
  taxTotal      Decimal @default(0) @db.Decimal(12, 2)
  total         Decimal @default(0) @db.Decimal(12, 2)

  notes      String?
  sentAt     DateTime?
  approvedAt DateTime?
  expiresAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items    QuoteItem[]
  payments Payment[]

  @@unique([organizationId, quoteNumber])
  @@index([serviceOrderId])
  @@index([customerId])
  @@index([vehicleId])
}

model QuoteItem {
  id      String @id @default(cuid())
  quoteId String
  quote   Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  partId String?
  part   Part? @relation(fields: [partId], references: [id])

  type        ServiceItemType
  name        String
  description String?

  quantity       Decimal @default(1) @db.Decimal(10, 2)
  unitPrice      Decimal @db.Decimal(12, 2)
  discountAmount Decimal @default(0) @db.Decimal(12, 2)
  totalPrice     Decimal @db.Decimal(12, 2)
  vatRate        Decimal @default(20) @db.Decimal(5, 2)
  vatAmount      Decimal @default(0) @db.Decimal(12, 2)
  grossTotal     Decimal @default(0) @db.Decimal(12, 2)

  approved Boolean?

  createdAt DateTime @default(now())

  @@index([quoteId])
  @@index([partId])
}

/* =========================================================
   GEÇMİŞ BAKIM
   ========================================================= */

model MaintenanceRecord {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id])

  serviceOrderId String?       @unique
  serviceOrder   ServiceOrder? @relation(fields: [serviceOrderId], references: [id])

  mileage     Int
  performedAt DateTime @default(now())
  totalAmount Decimal  @default(0) @db.Decimal(12, 2)
  notes       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items MaintenanceItem[]

  @@index([organizationId])
  @@index([vehicleId])
}

model MaintenanceItem {
  id                  String            @id @default(cuid())
  maintenanceRecordId String
  maintenanceRecord   MaintenanceRecord @relation(fields: [maintenanceRecordId], references: [id], onDelete: Cascade)

  partId String?
  part   Part? @relation(fields: [partId], references: [id])

  name        String
  description String?
  quantity    Decimal @default(1) @db.Decimal(10, 2)
  unitPrice   Decimal @default(0) @db.Decimal(12, 2)
  totalPrice  Decimal @default(0) @db.Decimal(12, 2)

  createdAt DateTime @default(now())

  @@index([maintenanceRecordId])
  @@index([partId])
}

/* =========================================================
   GELECEK BAKIM PLANI
   ========================================================= */

model MaintenancePlan {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id])

  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id])

  title       String
  category    String?
  description String?

  intervalKm     Int?
  intervalMonths Int?

  lastKm   Int?
  lastDate DateTime?

  nextDueKm   Int?
  nextDueDate DateTime?

  estimatedPriceMin Decimal? @db.Decimal(12, 2)
  estimatedPriceMax Decimal? @db.Decimal(12, 2)

  status MaintenancePlanStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([vehicleId])
  @@index([nextDueDate])
}

/* =========================================================
   HAZIR BAKIM PAKETLERİ
   ========================================================= */

model MaintenancePackage {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  name        String
  description String?
  active      Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items MaintenancePackageItem[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model MaintenancePackageItem {
  id                   String             @id @default(cuid())
  maintenancePackageId String
  maintenancePackage   MaintenancePackage @relation(fields: [maintenancePackageId], references: [id], onDelete: Cascade)

  type        ServiceItemType
  name        String
  description String?

  quantity  Decimal @default(1) @db.Decimal(10, 2)
  unitPrice Decimal @default(0) @db.Decimal(12, 2)
  vatRate   Decimal @default(20) @db.Decimal(5, 2)

  createdAt DateTime @default(now())

  @@index([maintenancePackageId])
}

/* =========================================================
   TEDARİKÇİ / PARÇA / STOK
   ========================================================= */

model Supplier {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  name      String
  phone     String?
  email     String?
  address   String?
  taxNumber String?
  notes     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parts Part[]

  @@index([organizationId])
}

model Part {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id])

  sku      String?
  oemCode  String?
  barcode  String?
  name     String
  brand    String?
  unit     String @default("ADET")

  purchasePrice Decimal @default(0) @db.Decimal(12, 2)
  salePrice     Decimal @default(0) @db.Decimal(12, 2)
  minimumStock  Decimal @default(0) @db.Decimal(12, 2)

  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inventories        Inventory[]
  inventoryMovements InventoryMovement[]
  serviceOrderItems  ServiceOrderItem[]
  quoteItems         QuoteItem[]
  maintenanceItems   MaintenanceItem[]

  @@unique([organizationId, sku])
  @@unique([organizationId, barcode])
  @@index([organizationId])
  @@index([supplierId])
}

model Inventory {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  partId String
  part   Part @relation(fields: [partId], references: [id])

  quantity    Decimal @default(0) @db.Decimal(12, 2)
  minQuantity Decimal @default(0) @db.Decimal(12, 2)
  location    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([branchId, partId])
  @@index([organizationId])
  @@index([partId])
}

model InventoryMovement {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  partId String
  part   Part @relation(fields: [partId], references: [id])

  serviceOrderId String?
  serviceOrder   ServiceOrder? @relation(fields: [serviceOrderId], references: [id])

  createdById String?
  createdBy   User? @relation(fields: [createdById], references: [id])

  type     InventoryMovementType
  quantity Decimal @db.Decimal(12, 2)
  unitCost Decimal? @db.Decimal(12, 2)
  note     String?

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([branchId])
  @@index([partId])
  @@index([serviceOrderId])
}

/* =========================================================
   FOTOĞRAF / BELGE
   ========================================================= */

model Media {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id])

  vehicleId String?
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id])

  serviceOrderId String?
  serviceOrder   ServiceOrder? @relation(fields: [serviceOrderId], references: [id])

  inspectionId String?
  inspection   Inspection? @relation(fields: [inspectionId], references: [id])

  uploadedById String?
  uploadedBy   User? @relation(fields: [uploadedById], references: [id])

  type       MediaType
  storageKey String   @unique
  fileName   String
  mimeType   String?
  sizeBytes  Int?
  description String?

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([vehicleId])
  @@index([serviceOrderId])
  @@index([inspectionId])
}

/* =========================================================
   BİLDİRİMLER
   ========================================================= */

model Notification {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id])

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  userId String?
  user   User? @relation(fields: [userId], references: [id])

  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])

  serviceOrderId String?
  serviceOrder   ServiceOrder? @relation(fields: [serviceOrderId], references: [id])

  channel NotificationChannel
  status  NotificationStatus @default(PENDING)

  title   String
  message String

  sentAt DateTime?
  readAt DateTime?

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([customerId])
  @@index([userId])
  @@index([serviceOrderId])
}

/* =========================================================
   ÖDEME
   ========================================================= */

model Payment {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  serviceOrderId String?
  serviceOrder   ServiceOrder? @relation(fields: [serviceOrderId], references: [id])

  quoteId String?
  quote   Quote? @relation(fields: [quoteId], references: [id])

  amount Decimal @db.Decimal(12, 2)

  method PaymentMethod
  status PaymentStatus @default(PENDING)

  reference String?
  paidAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([customerId])
  @@index([serviceOrderId])
}

/* =========================================================
   AUDIT LOG
   ========================================================= */

model AuditLog {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id])

  userId String?
  user   User? @relation(fields: [userId], references: [id])

  action     String
  entityType String
  entityId   String

  oldData Json?
  newData Json?

  ipAddress String?

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([userId])
  @@index([entityType, entityId])
}